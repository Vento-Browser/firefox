JAR_MANIFESTS += ["jar.mn"]

# Isolated, engine-agnostic fingerprint core (see fingerprint/README.md). Kept in
# its own resource subdir so it can be lifted into a standalone repo with only the
# nsRFPService injection point (documented in the README) left behind in-tree.
EXTRA_JS_MODULES.fingerprint += [
    "fingerprint/VentoAudio.sys.mjs",
    "fingerprint/VentoBehavioralQuantizer.sys.mjs",
    "fingerprint/VentoFingerprintProfile.sys.mjs",
    "fingerprint/VentoFonts.sys.mjs",
    "fingerprint/VentoInputDevices.sys.mjs",
    "fingerprint/VentoMiscSurfaces.sys.mjs",
    "fingerprint/VentoTimeLocale.sys.mjs",
]

EXTRA_JS_MODULES.fingerprint.network += [
    "fingerprint/network/VentoNetworkFingerprint.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Vento")
