# Isolated native side of the Vento deterministic-identity feature. This is the
# only compiled Vento fingerprint code in-tree; nsRFPService includes the header
# below at its single injection point (see fingerprint/README.md).

EXPORTS.mozilla.vento += [
    "VentoFingerprintSeed.h",
]

UNIFIED_SOURCES += [
    "VentoFingerprintSeed.cpp",
]

TEST_DIRS += ["gtest"]

FINAL_LIBRARY = "xul"

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Vento")
